<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>Happy Birthday Baby 💖</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Great+Vibes&family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>

*{
box-sizing:border-box;
margin:0;
padding:0
}

html,body{
width:100%;
height:100%;
overflow:hidden
}

body{
background:radial-gradient(circle at center,#4b1535 0%,#1a0717 45%,#050205 100%);
color:white;
font-family:'Poppins',sans-serif;
display:flex;
align-items:center;
justify-content:center
}

/* GALAXY */

#galaxy-canvas{
position:fixed;
inset:0;
width:100%;
height:100%;
z-index:1;
cursor:grab
}

#galaxy-canvas:active{
cursor:grabbing
}

/* BACKGROUND GLOW */

body::before{
content:"";
position:fixed;
width:500px;
height:500px;
border-radius:50%;
background:rgba(255,50,160,.12);
filter:blur(100px);
top:50%;
left:50%;
transform:translate(-50%,-50%);
pointer-events:none;
z-index:0;
animation:galaxyGlow 5s ease-in-out infinite alternate
}

@keyframes galaxyGlow{
from{
transform:translate(-50%,-50%) scale(.8);
opacity:.4
}
to{
transform:translate(-50%,-50%) scale(1.3);
opacity:1
}
}

/* FLOATING HEARTS */

.bg-heart{
position:fixed;
color:#ff71ce;
font-size:20px;
pointer-events:none;
z-index:4;
filter:drop-shadow(0 0 6px #ff71ce) drop-shadow(0 0 15px #ff007f);
animation:floatHeart linear forwards
}

@keyframes floatHeart{
0%{
transform:translateY(105vh) translateX(0) scale(.4) rotate(0deg);
opacity:0
}
10%{
opacity:1
}
50%{
transform:translateY(50vh) translateX(25px) scale(1) rotate(180deg)
}
100%{
transform:translateY(-15vh) translateX(-30px) scale(1.4) rotate(360deg);
opacity:0
}
}

/* SPARKLES */

.sparkle{
position:fixed;
width:7px;
height:7px;
border-radius:50%;
background:white;
box-shadow:
0 0 8px white,
0 0 15px #ff71ce,
0 0 25px #ff007f;
pointer-events:none;
z-index:100;
animation:sparkleFade .8s ease-out forwards
}

@keyframes sparkleFade{
0%{
opacity:1;
transform:scale(.4)
}
50%{
transform:scale(1.6)
}
100%{
opacity:0;
transform:scale(0)
}
}

/* =========================================
   BUBU & DUDU STICKERS
========================================= */

.sticker-container{
position:fixed;
inset:0;
z-index:25;
pointer-events:none
}

.bubu{
position:absolute;
width:85px;
height:85px;
object-fit:contain;
display:block;
pointer-events:none;
user-select:none;
-webkit-user-drag:none;
border:none;

filter:
drop-shadow(0 0 7px rgba(255,113,206,.9))
drop-shadow(0 0 18px rgba(255,0,127,.5))
}

/* ORIGINAL FOUR */

.bubu1{
top:10px;
left:10px;
animation:bubuFloat1 3.5s ease-in-out infinite
}

.bubu2{
top:10px;
right:10px;
animation:bubuFloat2 4s ease-in-out infinite
}

.bubu3{
bottom:10px;
left:10px;
animation:bubuFloat3 3.8s ease-in-out infinite
}

.bubu4{
bottom:10px;
right:10px;
animation:bubuFloat4 4.2s ease-in-out infinite
}

/* NEW STICKERS */

.bubu5{
top:22%;
left:8px;
animation:bubuFloat5 4s ease-in-out infinite
}

.bubu6{
top:22%;
right:8px;
animation:bubuFloat6 4.5s ease-in-out infinite
}

.bubu7{
bottom:24%;
left:8px;
animation:bubuFloat7 4.2s ease-in-out infinite
}

.bubu8{
bottom:24%;
right:8px;
animation:bubuFloat8 3.7s ease-in-out infinite
}

/* FLOAT ANIMATIONS */

@keyframes bubuFloat1{
0%,100%{
transform:translateY(0) rotate(-5deg) scale(1)
}
50%{
transform:translateY(-12px) rotate(5deg) scale(1.08)
}
}

@keyframes bubuFloat2{
0%,100%{
transform:translateY(0) rotate(5deg) scale(1)
}
50%{
transform:translateY(12px) rotate(-5deg) scale(1.08)
}
}

@keyframes bubuFloat3{
0%,100%{
transform:translateX(0) rotate(4deg)
}
50%{
transform:translateX(12px) rotate(-4deg)
}
}

@keyframes bubuFloat4{
0%,100%{
transform:translateY(0) rotate(-4deg)
}
50%{
transform:translateY(-13px) rotate(4deg)
}
}

@keyframes bubuFloat5{
0%,100%{
transform:translateX(0) rotate(-6deg)
}
50%{
transform:translateX(14px) rotate(6deg)
}
}

@keyframes bubuFloat6{
0%,100%{
transform:translateX(0) rotate(6deg)
}
50%{
transform:translateX(-14px) rotate(-6deg)
}
}

@keyframes bubuFloat7{
0%,100%{
transform:translateY(0) rotate(5deg)
}
50%{
transform:translateY(-15px) rotate(-5deg)
}
}

@keyframes bubuFloat8{
0%,100%{
transform:translateY(0) rotate(-5deg)
}
50%{
transform:translateY(15px) rotate(5deg)
}
}

/* MAIN CONTAINER */

.container{
position:relative;
z-index:10;
width:90%;
max-width:580px;
max-height:84vh;
overflow-y:auto;
padding:30px 20px;
text-align:center;

border-radius:28px;

background:linear-gradient(
145deg,
rgba(65,15,48,.91),
rgba(18,5,18,.94)
);

border:1px solid rgba(255,113,206,.5);

box-shadow:
0 0 30px rgba(255,113,206,.25),
0 0 70px rgba(255,0,127,.15);

backdrop-filter:blur(18px);
-webkit-backdrop-filter:blur(18px);

animation:cardAppear .8s ease
}

@keyframes cardAppear{
from{
opacity:0;
transform:translateY(30px) scale(.95)
}
to{
opacity:1;
transform:translateY(0) scale(1)
}
}

/* HEADINGS */

h1{
font-family:'Great Vibes',cursive;
font-size:3rem;
font-weight:normal;
color:#ff9bdd;

text-shadow:
0 0 6px white,
0 0 15px #ff71ce,
0 0 30px #ff007f;

animation:titleGlow 2s ease-in-out infinite alternate
}

@keyframes titleGlow{
from{
text-shadow:
0 0 5px white,
0 0 12px #ff71ce
}
to{
text-shadow:
0 0 8px white,
0 0 22px #ff71ce,
0 0 35px #ff007f
}
}

.subtitle{
font-size:.85rem;
color:#ffd8e8;
margin:8px 0 20px
}

/* PAGES */

.page{
display:none;
animation:fadeIn .5s ease forwards
}

.page.active{
display:block
}

@keyframes fadeIn{
from{
opacity:0;
transform:translateY(15px)
}
to{
opacity:1;
transform:translateY(0)
}
}

/* =========================================
   BIRTHDAY CAKE MENU
========================================= */

.cake-menu{
position:relative;
width:100%;
min-height:500px;

display:flex;
justify-content:center;
align-items:center;

padding-top:15px;
padding-bottom:15px;
}

/* MUSIC NOTICE ON CAKE MENU */

.music-first{
position:absolute;
top:0;
left:50%;
transform:translateX(-50%);

width:90%;
max-width:330px;

padding:9px 14px;

border-radius:22px;

background:rgba(255,113,206,.16);

border:1px solid rgba(255,113,206,.5);

color:#ffe3ef;

font-size:.72rem;
font-weight:500;

text-shadow:0 0 8px #ff71ce;

box-shadow:
0 0 10px rgba(255,113,206,.2),
0 0 25px rgba(255,0,127,.15);

animation:musicNotice 2s ease-in-out infinite alternate;

z-index:30;
}

@keyframes musicNotice{
from{
transform:translateX(-50%) translateY(0);
box-shadow:0 0 8px rgba(255,113,206,.2)
}
to{
transform:translateX(-50%) translateY(-4px);
box-shadow:
0 0 18px rgba(255,113,206,.5),
0 0 30px rgba(255,0,127,.25)
}
}

/* CAKE */

.birthday-cake{
position:relative;
width:390px;
height:390px;

display:flex;
flex-direction:column;
align-items:center;
justify-content:flex-end;

filter:
drop-shadow(0 0 12px rgba(255,113,206,.45))
drop-shadow(0 0 35px rgba(255,0,127,.25));

animation:cakeFloat 4s ease-in-out infinite;
}

@keyframes cakeFloat{
0%,100%{
transform:translateY(0)
}
50%{
transform:translateY(-8px)
}
}

/* CAKE TOP */

.cake-top{
position:absolute;
top:15px;

width:205px;
height:70px;

border-radius:50% 50% 20px 20px;

background:
linear-gradient(
to bottom,
#ffd9ed 0%,
#ffb5d9 45%,
#ff75b9 100%
);

border:3px solid rgba(255,255,255,.55);

box-shadow:
inset 0 -12px 0 rgba(255,0,127,.18),
0 0 15px rgba(255,113,206,.4);

z-index:6;
}

/* TOP FROSTING */

.cake-top:before{
content:"";
position:absolute;

left:8px;
right:8px;
bottom:-17px;

height:35px;

background:#fff0f7;

border-radius:0 0 50% 50%;

box-shadow:
0 4px 0 #ff9dca,
0 8px 12px rgba(255,0,127,.2);
}

/* CANDLES */

.candles{
position:absolute;
top:-35px;
left:50%;

transform:translateX(-50%);

display:flex;
gap:18px;

z-index:10;
}

.candle{
position:relative;

width:10px;
height:34px;

border-radius:5px;

background:
repeating-linear-gradient(
-45deg,
#ff71ce 0px,
#ff71ce 5px,
#fff 5px,
#fff 10px
);

box-shadow:0 0 8px rgba(255,113,206,.7);
}

.flame{
position:absolute;

top:-19px;
left:50%;

transform:translateX(-50%);

font-size:20px;

animation:flame 1s ease-in-out infinite alternate;
}

@keyframes flame{
from{
transform:translateX(-50%) scale(.85);
filter:drop-shadow(0 0 4px #ff9d00)
}
to{
transform:translateX(-50%) scale(1.15);
filter:drop-shadow(0 0 10px #ff9d00)
}
}

/* TOP TEXT */

.cake-title{
position:absolute;

top:27px;
left:50%;

transform:translateX(-50%);

width:185px;

font-family:'Great Vibes',cursive;

font-size:1.7rem;

color:white;

text-shadow:
0 0 5px white,
0 0 10px #ff71ce,
0 0 20px #ff007f;

z-index:12;

white-space:nowrap;
}

/* SECOND LAYER */

.cake-middle{
position:absolute;

top:78px;

width:290px;
height:100px;

border-radius:25px 25px 35px 35px;

background:
linear-gradient(
to bottom,
#ff8bc5,
#ff559f 55%,
#e92b82
);

border:3px solid rgba(255,255,255,.45);

box-shadow:
inset 0 -15px 0 rgba(155,0,75,.18),
0 0 15px rgba(255,113,206,.35);

z-index:5;
}

.cake-middle:before{
content:"";

position:absolute;

top:-10px;
left:-3px;
right:-3px;

height:30px;

background:#ffe6f2;

border-radius:50%;

box-shadow:
0 8px 0 #ff9dca;
}

/* THIRD LAYER */

.cake-bottom{
position:absolute;

top:168px;

width:365px;
height:130px;

border-radius:30px 30px 45px 45px;

background:
linear-gradient(
to bottom,
#ff71b5,
#ff3e91 55%,
#d91d72
);

border:3px solid rgba(255,255,255,.45);

box-shadow:
inset 0 -20px 0 rgba(125,0,55,.2),
0 0 20px rgba(255,113,206,.4);

z-index:4;
}

.cake-bottom:before{
content:"";

position:absolute;

top:-13px;
left:-3px;
right:-3px;

height:35px;

background:#fff0f7;

border-radius:50%;

box-shadow:
0 8px 0 #ff9dca;
}

/* CAKE DECORATIONS */

.cake-dot{
position:absolute;

width:10px;
height:10px;

border-radius:50%;

background:#fff;

box-shadow:0 0 8px #fff;

z-index:8;
}

.dot1{left:40px;top:45px}
.dot2{right:55px;top:70px}
.dot3{left:80px;top:105px}
.dot4{right:100px;top:120px}
.dot5{left:55px;top:225px}
.dot6{right:70px;top:245px}
.dot7{left:150px;top:270px}
.dot8{right:145px;top:205px}

/* MENU BUTTONS */

.cake-buttons{
position:absolute;

left:50%;
top:175px;

transform:translateX(-50%);

width:320px;

display:grid;

grid-template-columns:1fr 1fr;

gap:18px;

z-index:20;
}

.cake-button{
height:52px;

border:none;
border-radius:18px;

background:
linear-gradient(
145deg,
rgba(255,240,248,.96),
rgba(255,151,203,.95)
);

color:#8b1554;

font-family:'Poppins',sans-serif;

font-size:.75rem;
font-weight:700;

cursor:pointer;

border:2px solid rgba(255,255,255,.75);

box-shadow:
0 5px 12px rgba(0,0,0,.25),
0 0 12px rgba(255,113,206,.55);

transition:.25s;

text-shadow:0 1px 0 white;
}

.cake-button:hover{
transform:translateY(-5px) scale(1.05);

box-shadow:
0 8px 20px rgba(255,0,127,.4),
0 0 20px rgba(255,113,206,.7)
}

.cake-button:active{
transform:scale(.92)
}

.cake-button span{
display:block;
font-size:22px;
line-height:20px;
margin-bottom:3px
}

/* PLATE */

.cake-plate{
position:absolute;

bottom:5px;

width:410px;
height:30px;

border-radius:50%;

background:
linear-gradient(
to bottom,
#fff,
#ffb7dc
);

border:2px solid rgba(255,255,255,.7);

box-shadow:
0 0 20px rgba(255,113,206,.5);

z-index:2;
}

/* CAKE MESSAGE */

.cake-subtitle{
position:absolute;

bottom:-2px;

font-size:.65rem;

color:#ffdcec;

letter-spacing:1px;

z-index:25;

white-space:nowrap;

text-shadow:0 0 8px #ff71ce;
}

/* BUTTON */

.btn{
display:inline-block;
margin:12px 8px 5px;
padding:11px 24px;

border:none;
border-radius:30px;

background:
linear-gradient(45deg,#ff71ce,#ff007f);

color:white;

font-family:'Poppins',sans-serif;
font-weight:600;

cursor:pointer;

box-shadow:
0 5px 18px rgba(255,0,127,.4);

transition:.25s
}

.btn:hover{
transform:scale(1.06);

box-shadow:
0 5px 25px rgba(255,0,127,.7)
}

.btn:active{
transform:scale(.94)
}

/* LETTER */

.letter-text{
text-align:left;

line-height:1.7;
font-size:.88rem;

background:rgba(0,0,0,.3);

border:1px solid rgba(255,113,206,.2);

padding:20px;

border-radius:18px;

margin-bottom:15px;

max-height:270px;

overflow-y:auto;

color:#ffe6f0;

white-space:pre-line
}

/* MUSIC */

.music-box{
display:flex;
align-items:center;
justify-content:center;

gap:20px;

background:rgba(0,0,0,.3);

padding:20px;

border-radius:20px;

border:1px solid rgba(255,113,206,.3);

flex-wrap:wrap
}

.cd-wrapper{
width:80px;
height:80px
}

.cd-disc{
width:100%;
height:100%;

border-radius:50%;

background:
repeating-radial-gradient(
#111,
#111 5px,
#292929 6px,
#111 7px
);

display:flex;
align-items:center;
justify-content:center;

box-shadow:
0 0 10px #ff71ce,
0 0 25px rgba(255,113,206,.5);

animation:spin 4s linear infinite
}

.cd-center{
width:24px;
height:24px;

background:#ff71ce;

border-radius:50%;

border:3px solid white
}

@keyframes spin{
100%{
transform:rotate(360deg)
}
}

iframe{
width:240px;
height:135px;
border:none;
border-radius:12px
}

/* FLOATING MESSAGES */

#messages-container{
position:fixed;
inset:0;
z-index:5;
pointer-events:none
}

.floating-text{
position:absolute;

color:white;

font-family:'Great Vibes',cursive;

font-size:1.05rem;

white-space:nowrap;

text-shadow:0 0 8px #ff71ce;

pointer-events:auto;

cursor:pointer;

background:rgba(255,113,206,.12);

padding:7px 15px;

border-radius:20px;

border:1px solid rgba(255,113,206,.35);

transition:.3s
}

.floating-text:hover{
transform:scale(1.25)!important;

background:rgba(255,113,206,.25)
}

/* GALAXY UI */

.galaxy-ui{
position:fixed;
inset:0;
z-index:15;
pointer-events:none;
display:none
}

.galaxy-ui.active{
display:block
}

/* BIRTHDAY BANNER */

.birthday-banner{
position:fixed;

top:15px;
left:50%;

transform:translateX(-50%);

display:flex;
align-items:center;

gap:7px;

padding:7px 13px;

border-radius:30px;

background:rgba(35,7,28,.75);

border:1px solid rgba(255,113,206,.5);

box-shadow:
0 0 20px rgba(255,113,206,.35);

backdrop-filter:blur(10px);
-webkit-backdrop-filter:blur(10px);

animation:bannerFloat 3s ease-in-out infinite
}

@keyframes bannerFloat{
0%,100%{
transform:translateX(-50%) translateY(0)
}
50%{
transform:translateX(-50%) translateY(-5px)
}
}

.birthday-banner h2{
font-family:'Great Vibes',cursive;

font-size:1.55rem;

font-weight:normal;

color:#ff9bdd;

white-space:nowrap;

text-shadow:
0 0 10px #ff71ce,
0 0 20px #ff007f
}

.banner-sticker{
width:38px;
height:38px;
object-fit:contain
}

/* HEART CENTER */

.heart-center{
position:fixed;

top:50%;
left:50%;

transform:translate(-50%,-50%);

text-align:center;

width:280px;

pointer-events:none;

z-index:14;

animation:heartPulse 3s ease-in-out infinite
}

@keyframes heartPulse{
0%,100%{
transform:translate(-50%,-50%) scale(1)
}
50%{
transform:translate(-50%,-50%) scale(1.05)
}
}

.heart-title{
font-family:'Great Vibes',cursive;

font-size:2.3rem;

color:white;

text-shadow:
0 0 6px white,
0 0 15px #ff71ce,
0 0 30px #ff007f
}

.cake{
font-size:38px;
margin-top:8px;

animation:cakeBounce 1.5s infinite
}

@keyframes cakeBounce{
0%,100%{
transform:translateY(0) rotate(-3deg)
}
50%{
transform:translateY(-8px) rotate(3deg)
}
}

.heart-hint{
font-size:.6rem;

color:rgba(255,255,255,.7);

margin-top:5px;

letter-spacing:1px
}

/* BACK BUTTON */

.btn-bottom-left{
position:fixed;

bottom:20px;
left:20px;

z-index:30;

pointer-events:auto
}

/* MODAL */

.modal{
position:fixed;

top:50%;
left:50%;

transform:translate(-50%,-50%) scale(0);

width:340px;

max-width:85%;

padding:25px;

background:rgba(20,5,20,.97);

border:1px solid #ff71ce;

border-radius:22px;

text-align:center;

z-index:50;

box-shadow:
0 0 30px rgba(255,113,206,.6);

transition:.4s
}

.modal.active{
transform:translate(-50%,-50%) scale(1)
}

.modal p{
font-family:'Great Vibes',cursive;

font-size:1.5rem;

line-height:1.5;

margin-bottom:15px
}

/* MOBILE */

@media(max-width:600px){

.container{
width:100%;
max-width:none;
max-height:100vh;

padding:15px 8px;

border-radius:0;

background:transparent;

border:none;

box-shadow:none;

backdrop-filter:none;
-webkit-backdrop-filter:none
}

h1{
font-size:2.5rem
}

.bubu{
width:68px;
height:68px
}

.bubu1{
top:6px;
left:4px
}

.bubu2{
top:6px;
right:4px
}

.bubu3{
bottom:6px;
left:4px
}

.bubu4{
bottom:6px;
right:4px
}

.bubu5{
top:25%;
left:2px
}

.bubu6{
top:25%;
right:2px
}

.bubu7{
bottom:25%;
left:2px
}

.bubu8{
bottom:25%;
right:2px
}

.music-first{
top:0;
font-size:.65rem;
padding:8px 10px;
width:88%
}

.birthday-banner{
top:9px;
padding:5px 9px
}

.birthday-banner h2{
font-size:1.25rem
}

.banner-sticker{
width:30px;
height:30px
}

.heart-title{
font-size:1.9rem
}

.heart-center{
width:250px
}

.cake{
font-size:32px
}

iframe{
width:100%;
max-width:240px
}

.btn-bottom-left{
bottom:12px;
left:12px;
padding:9px 17px;
font-size:.75rem
}

/* MOBILE CAKE */

.cake-menu{
min-height:470px;

transform:scale(.88);

margin-top:5px;
margin-bottom:-10px
}

.birthday-cake{
width:360px;
height:370px
}

.cake-top{
width:185px;
height:65px
}

.cake-middle{
width:270px;
height:95px
}

.cake-bottom{
width:340px;
height:120px
}

.cake-buttons{
width:300px;
gap:13px;

top:166px
}

.cake-button{
height:48px;
font-size:.68rem;
